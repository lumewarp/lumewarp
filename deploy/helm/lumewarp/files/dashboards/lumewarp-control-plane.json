      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lumewarp_cp_compile_failures_total{namespace=~\"${namespace:regex}\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "failures",
          "range": true
        }
      ]
    },
