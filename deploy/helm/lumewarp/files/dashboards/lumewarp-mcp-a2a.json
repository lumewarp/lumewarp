      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lumewarp_a2a_requests_total{namespace=~\"${namespace:regex}\",agent=~\"${agent:regex}\",status=~\"5..\"}[$__rate_interval])) / sum(rate(lumewarp_a2a_requests_total{namespace=~\"${namespace:regex}\",agent=~\"${agent:regex}\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "5xx",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "title": "Top MCP tools",
      "description": "Ten busiest tools; tools without an approved definition are counted as `_unapproved`.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "namePlacement": "auto",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (server, tool) (rate(lumewarp_mcp_tool_calls_total{namespace=~\"${namespace:regex}\",server=~\"${server:regex}\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{server}} / {{tool}}",
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "title": "Top A2A agents",
      "description": "Ten busiest agents by request rate.",
