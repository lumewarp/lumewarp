        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "namePlacement": "auto",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (requested) (increase(lumewarp_tokens_total{namespace=~\"${namespace:regex}\",requested=~\"${requested:regex}\",team=~\"${team:regex}\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{requested}}",
          "range": true
        }
      ]
    },
    {
      "id": 15,
      "title": "Top teams by spend in range",
      "description": "Spend is team-only: the gateway exports no requested-name cost, so this panel ignores the requested filter.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
