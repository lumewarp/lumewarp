{
  "realm": "lumewarp",
  "enabled": true,
  "displayName": "Lumewarp dev",
  "sslRequired": "none",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "groups": [{"name": "lumewarp-admins"}],
  "clients": [
    {
      "clientId": "lumewarp-cp",
      "name": "Lumewarp control plane",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "lumewarp-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "redirectUris": [
        "http://localhost:8091/api/v1/session/oidc/callback",
        "http://127.0.0.1:8091/api/v1/session/oidc/callback",
        "http://localhost:5173/api/v1/session/oidc/callback",
        "http://127.0.0.1:5173/api/v1/session/oidc/callback"
      ],
      "webOrigins": [
        "http://localhost:8091",
        "http://127.0.0.1:8091",
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8091/*##http://127.0.0.1:8091/*##http://localhost:5173/*##http://127.0.0.1:5173/*"
      }
    }
  ],
  "users": [
    {
      "username": "alice@example.com",
      "groups": ["lumewarp-admins"],
      "email": "alice@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Dev",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "lumewarp",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob@example.com",
      "email": "bob@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Dev",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "lumewarp",
          "temporary": false
        }
      ]
    },
    {
      "username": "carol@example.com",
      "email": "carol@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Carol",
      "lastName": "Dev",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "lumewarp",
          "temporary": false
        }
      ]
    }
  ]
}
