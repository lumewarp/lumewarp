# OpenFGA authorization model for Lumewarp.
#
# The relations mirror `authz.Relation` in the control plane: `superuser` on the
# installation, and `admin` / `member` on a team. `admin` implies `member`, and an
# installation `superuser` is an admin of every team through its `installation`
# relation. The IdP is authentication only; grants live here.
model
  schema 1.1

type user

type installation
  relations
    define superuser: [user]

type team
  relations
    define installation: [installation]
    define admin: [user] or superuser from installation
    define member: [user] or admin
