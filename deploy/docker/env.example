# Copy to `.env` next to compose.yaml and fill in. Keep `.env` out of version control.
# Values are passed to the containers as they are: do not quote them.

# Image tag of both components.
LUMEWARP_VERSION=0.1.0

# Postgres password; the database itself lives in the `postgres` volume.
POSTGRES_PASSWORD=

# Emergency login: an argon2id hash from
#   docker compose run --rm -T control-plane hash-password <<< 'your password'
# Every `$` in the hash must be written `$$` in this file.
LUMEWARP_BREAK_GLASS_PASSWORD_HASH=

# Seals upstream API keys stored through the API; the gateway needs the same value.
# At least 32 random characters, e.g. `openssl rand -base64 48`.
LUMEWARP_ENCRYPTION_KEY=

# Session cookies are `Secure`. Leave this true behind HTTPS; set false only to sign
# in over plain HTTP on a host other than localhost.
LUMEWARP_SESSION_COOKIE_SECURE=true

# The gateway token, printed once by
#   docker compose run --rm control-plane bootstrap --name gateway
LUMEWARP_GATEWAY_TOKEN=

# Shares rpm/tpm/max_parallel counts across every gateway that points at the same Redis,
# e.g. redis://:password@redis:6379/0; this file runs one gateway, so leave it off.
# LUMEWARP_SHARED_LIMITS_REDIS_URL=

# MCP and A2A (optional): a base64 key of at least 32 bytes (`openssl rand -base64 32`)
# and the URL clients reach the gateway at. Without them those endpoints answer 503.
LUMEWARP_GATEWAY_ID_KEY=
LUMEWARP_GATEWAY_PUBLIC_URL=

# SSO (optional): see docs/operations/identity.md for the LUMEWARP_OIDC_* settings and
# LUMEWARP_SECRET_KEY, and add them here.
