    {
      "id": 8,
      "title": "Plugin calls / second by result",
      "description": "Request-path calls only: `ok`, `error` (the plugin returned an error), `trap` and `timeout`. Built-in strategies and auth run inline and are not counted.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
