          "refId": "A",
          "expr": "sum by (server, tool) (rate(lumewarp_mcp_tool_calls_total{namespace=~\"${namespace:regex}\",server=~\"${server:regex}\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{server}} {{tool}}",
          "range": true
        }
      ]
    },
