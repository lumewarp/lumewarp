{
  "uid": "lumewarp-routing",
  "title": "Lumewarp / Routing",
  "description": "Per-model health at a glance, fallback and retry pressure, traffic split shares, session affinity and the routing trends. Model and upstream gauges intentionally cover all requested names.",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "tags": [
    "lumewarp",
    "routing"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values({__name__=~\"lumewarp_(cp_)?config_version\"}, namespace)",
          "refId": "namespace"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "requested",
        "label": "Requested",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(lumewarp_requests_total{namespace=~\"${namespace:regex}\"}, requested)",
          "refId": "requested"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "router",
        "label": "Router",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(lumewarp_fallbacks_total{namespace=~\"${namespace:regex}\"}, router)",
          "refId": "router"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(lumewarp_requests_total{namespace=~\"${namespace:regex}\"}, model)",
          "refId": "model"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet health",
      "description": "One row per model with instant values, so a bad member is visible without reading a line chart.",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "targets": []
    },
    {
      "id": 2,
      "title": "Per-model health",
      "description": "Instant values per model. Health is the type-specific probe, circuit is the breaker state, queue and KV cache come from the vLLM scrape, p99 and 5xx come from the request metrics. Empty cells mean the metric does not exist for that model.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Unhealthy",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Healthy",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Circuit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Closed",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "Half-open",
                        "color": "yellow",
                        "index": 1
                      },
                      "2": {
                        "text": "Open",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "In flight"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "vLLM queue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "KV cache"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.7
                    },
                    {
                      "color": "red",
                      "value": 0.9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 5
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.01
                    },
                    {
                      "color": "red",
                      "value": 0.05
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": "",
          "countRows": false
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "model",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true
            },
            "renameByName": {
              "model": "Model",
              "Value #A": "Health",
              "Value #B": "Circuit",
              "Value #C": "In flight",
              "Value #D": "vLLM queue",
              "Value #E": "KV cache",
              "Value #F": "p99",
              "Value #G": "5xx",
              "Value 1": "Health",
              "Value 2": "Circuit",
              "Value 3": "In flight",
              "Value 4": "vLLM queue",
              "Value 5": "KV cache",
              "Value 6": "p99",
              "Value 7": "5xx"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "max by (model) (lumewarp_model_healthy{namespace=~\"${namespace:regex}\",model=~\"${model:regex}\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{model}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "max by (model) (lumewarp_upstream_circuit_state{namespace=~\"${namespace:regex}\",model=~\"${model:regex}\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{model}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "sum by (model) (lumewarp_in_flight_requests{namespace=~\"${namespace:regex}\",model=~\"${model:regex}\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{model}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "max by (model) (lumewarp_vllm_queue_depth{namespace=~\"${namespace:regex}\",model=~\"${model:regex}\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{model}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "expr": "max by (model) (lumewarp_vllm_kv_cache_usage{namespace=~\"${namespace:regex}\",model=~\"${model:regex}\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{model}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "F",
          "expr": "histogram_quantile(0.99, sum by (model, le) (rate(lumewarp_request_duration_seconds_bucket{namespace=~\"${namespace:regex}\",model=~\"${model:regex}\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{model}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "G",
          "expr": "sum by (model) (rate(lumewarp_requests_total{namespace=~\"${namespace:regex}\",model=~\"${model:regex}\",status=~\"5..\"}[5m])) / sum by (model) (rate(lumewarp_requests_total{namespace=~\"${namespace:regex}\",model=~\"${model:regex}\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{model}}",
          "format": "table",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "row",
      "title": "Failures and retries",
      "description": "Where requests leave the chosen path.",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "targets": []
    },
    {
      "id": 4,
      "title": "Fallbacks per second",
      "description": "Fallback transitions per router and fallback model; only routers with a fallback produce series.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "namePlacement": "auto",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (router, model) (rate(lumewarp_fallbacks_total{namespace=~\"${namespace:regex}\",router=~\"${router:regex}\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{router}} -> {{model}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Retry budgets exhausted",
      "description": "Requests that used up the router's retry budget; a sustained value means upstreams keep failing retryable attempts.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "namePlacement": "auto",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (router) (rate(lumewarp_retries_budget_exhausted_total{namespace=~\"${namespace:regex}\",router=~\"${router:regex}\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{router}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Upstream attempt outcomes",
      "description": "Attempt outcomes across all models; `circuit_open` means the attempt was refused locally.",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(lumewarp_upstream_attempts_total{namespace=~\"${namespace:regex}\",requested=~\"${requested:regex}\",model=~\"${model:regex}\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Traffic splits",
      "description": "Canary and weighted split assignment.",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "targets": []
    },
    {
      "id": 8,
      "title": "Traffic split share",
      "description": "Requests assigned to each split, per router; `sticky` hashes a header, team or key to a split.",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (router, split) (rate(lumewarp_split_requests_total{namespace=~\"${namespace:regex}\",router=~\"${router:regex}\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{router}} {{split}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Traffic splits / second",
      "description": "Split assignment rate per router and split.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (router, split) (rate(lumewarp_split_requests_total{namespace=~\"${namespace:regex}\",router=~\"${router:regex}\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{router}} {{split}}",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Session affinity",
      "description": "Routers with session affinity: how often a session stuck, how often it moved and how many overrides are live.",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "targets": []
    },
    {
      "id": 11,
      "title": "Affinity hit share",
      "description": "Share of session-bearing requests that landed on the affinity choice (hash, override or moved). `none` counts requests without a session id.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lumewarp_session_affinity_total{namespace=~\"${namespace:regex}\",router=~\"${router:regex}\",result=~\"hash|override|moved\"}[$__rate_interval])) / sum(rate(lumewarp_session_affinity_total{namespace=~\"${namespace:regex}\",router=~\"${router:regex}\",result=~\"hash|override|moved|none\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "hit share",
          "range": true
        }
      ]
