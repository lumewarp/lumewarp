{
  "uid": "lumewarp-usage",
  "title": "Lumewarp / Usage",
  "description": "Token and spend totals with a period-over-period change, token mix, ranked leaders and usage-pipeline health. Spend is team-only because the gateway does not export requested-level cost; pipeline panels are global.",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "tags": [
    "lumewarp",
    "usage"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values({__name__=~\"lumewarp_(cp_)?config_version\"}, namespace)",
          "refId": "namespace"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(lumewarp_tokens_total{namespace=~\"${namespace:regex}\"}, team)",
          "refId": "team"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "requested",
        "label": "Requested",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(lumewarp_requests_total{namespace=~\"${namespace:regex}\"}, requested)",
          "refId": "requested"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Totals",
      "description": "Totals for the selected range with the percent change against the immediately preceding range of equal length.",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "targets": []
    },
    {
      "id": 2,
      "title": "Tokens in range",
      "description": "Input plus output tokens; the second value is the change against the previous equal-length range.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "none"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vs previous"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(lumewarp_tokens_total{namespace=~\"${namespace:regex}\",team=~\"${team:regex}\",requested=~\"${requested:regex}\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "tokens",
          "range": true
        },
        {
          "refId": "B",
          "expr": "(sum(increase(lumewarp_tokens_total{namespace=~\"${namespace:regex}\",team=~\"${team:regex}\",requested=~\"${requested:regex}\"}[$__range])) - sum(increase(lumewarp_tokens_total{namespace=~\"${namespace:regex}\",team=~\"${team:regex}\",requested=~\"${requested:regex}\"}[$__range] offset $__range))) / sum(increase(lumewarp_tokens_total{namespace=~\"${namespace:regex}\",team=~\"${team:regex}\",requested=~\"${requested:regex}\"}[$__range] offset $__range)) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "vs previous",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Spend in range",
