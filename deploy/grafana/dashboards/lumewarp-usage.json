          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{state}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "CP events ingested / second",
      "description": "",
