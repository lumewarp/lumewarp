        {
          "refId": "B",
          "expr": "(sum(increase(lumewarp_spend_total{namespace=~\"${namespace:regex}\",team=~\"${team:regex}\"}[$__range])) - sum(increase(lumewarp_spend_total{namespace=~\"${namespace:regex}\",team=~\"${team:regex}\"}[$__range] offset $__range))) / sum(increase(lumewarp_spend_total{namespace=~\"${namespace:regex}\",team=~\"${team:regex}\"}[$__range] offset $__range)) * 100",
