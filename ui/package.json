{
  "name": "lumewarp-ui",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && node --test scripts/check-shadcn.test.mjs && node scripts/check-shadcn.mjs",
    "gen:api": "LUMEWARP_DATABASE_URL=postgresql+asyncpg://nobody:nothing@127.0.0.1:1/none uv run --project ../control-plane python -m lumewarp_control_plane openapi -o openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts && rm openapi.json",
    "build:cp": "pnpm build && node scripts/copy-static.mjs",
    "test:e2e": "pnpm build:cp && playwright test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.85",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "ai": "7.0.163",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.65.0",
    "openapi-fetch": "~0.13.8",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.2.2"
}
